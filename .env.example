PORT=3000
VIDEO_PROVIDER=fal

# Fal.ai API Credentials (Required for AI Video Generation, Flux Restyling, Nano Banana Harmonization)
FAL_KEY=
FAL_API_KEY=

# OpenAI API Key (Optional: for vision analysis, scene deconstruction, and GPT flare asset generation)
OPENAI_API_KEY=

# Google Gemini API Key (Optional: for Gemini Vision multimodal analysis)
GEMINI_API_KEY=

# Kling AI Credentials (Optional: if using Kling video provider)
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# Model Endpoints
FAL_MODEL=bytedance/seedance-2.5/image-to-video
FAL_RESTYLE_MODEL=fal-ai/flux-general/image-to-image
ASSET_GEN_MODEL=openai/gpt-image-2.5/flare/edit
HARMONIZE_MODEL=fal-ai/nano-banana-pro/edit
